                        <label for="colFormLabelSm" class="col-sm-4 col-form-label col-form-label">Localidad:</label>
                        <div class="col-sm-8">
                            <span id="txtLoc"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="row mb-3">
                        <label for="colFormLabelSm" class="col-sm-4 col-form-label col-form-label">Calle:</label>
                        <div class="col-sm-8">
                            <span id="txtCalle"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row mb-3">
                        <label for="colFormLabelSm" class="col-sm-4 col-form-label col-form-label">Número exterior:</label>
                        <div class="col-sm-8">
                            <span id="txtNuEx"></span>
                        </div>
                    </div>
