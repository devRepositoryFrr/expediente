                            <span id="txtNuIn"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="row mb-3">
                        <label for="colFormLabelSm" class="col-sm-4 col-form-label col-form-label">Colonia:</label>
                        <div class="col-sm-8">
                            <span id="txtCol"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row mb-3">
                        <label for="colFormLabelSm" class="col-sm-4 col-form-label col-form-label">Cp:</label>
                        <div class="col-sm-8">
                            <span id="txtCp"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row mb-3">
                        <label for="colFormLabelSm" class="col-sm-4 col-form-label col-form-label">Referencia:</label>
