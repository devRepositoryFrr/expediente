                    <div class="input-group">
                        <div class="input-group-text"><i class="fa fa-calendar" aria-hidden="true"></i></div>
                        <input type="text" id="fechaVisita" name="FchAcordada" class="form-control" autocomplete="off">
                    </div>
                </div>
                <div class="mb-3" id="lugar" style="display:none">
                    <label for="Lugar" class="form-label">Indique el lugar acordado para la visita</label>
                    <textarea class="form-control" id="Lugar" name="Lugar" rows="4"></textarea>
                </div>
                <div class="mb-3" id="motivo">
