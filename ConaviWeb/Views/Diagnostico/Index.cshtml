                    <label class="form-label" for="fechaSolicitud" id="lblNV"></label>
                    <input type="hidden" class="form-control" id="NuVisita" name="NuVisita"/>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="fechaSolicitud">Fecha del primer intento de programación de visita</label>
