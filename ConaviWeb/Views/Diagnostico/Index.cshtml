<script>
    $(document).ready(function () {
        showAlert();
        $('input:radio[name=Prueba]').click();
        $('#fechaSolicitud').datepicker();
        $('#fechaSolicitud').datepicker('setDate', new Date());
        $('#fechaVisita').datepicker();
        $('#fechaSolicitudS').datepicker();
        $('#fechaVisitaS').datepicker();
        //$("#NuVisita").attr("disabled", "disabled");
        $("#btnCaptacion").attr("disabled", "disabled");
        $("#btnV1").attr("disabled", "disabled");
        $("#capOp").hide();
        $("#capVi").hide();
    });
        $('input:radio[name=Prueba]').click(function() {
    var value = $(this).val();
    if(value == "no"){
        $("#operacion").show()
        $("#ident").show()
    }else{
        $("#operacion").hide()
        $("#ident").hide()
    }
    });
    $('input:radio[name=Acordo]').click(function() {
    var value = $(this).val();
    if(value == "si"){
        $("#fecha").show()
        $("#lugar").show()
        $("#motivo").hide()
    }else{
        $("#fecha").hide()
        $("#lugar").hide()
        $("#motivo").show()
    }
    });
    $('input:radio[name=radioLevS]').click(function() {
    var value = $(this).val();
    if(value == "si"){
        $("#fechaS").show()
        $("#lugarS").show()
        $("#motivoS").hide()
    }else{
        $("#fechaS").hide()
        $("#lugarS").hide()
        $("#motivoS").show()
    }
    });
        $("#btnBuscarBen").click(function(e) {
            let curp = $("#txtCurp").val();
            urlInf = '@Url.Action("GetBenef", "Diagnostico")/' + curp;
			//console.log(urlInf);
      $.ajax({
        contentType: "application/json",
        type: "GET",
        url: urlInf,
        data: JSON.stringify({
          // name: document.getElementById("name").value,
          // email: document.getElementById("emailAddress").value
        }),
        complete: function(data) {
            //console.log(data.responseJSON.data.length)
            $("#IdUnico").val(data.responseJSON.data[0].idUnico);
            $("#IdUnico").val(data.responseJSON.data[0].idUnico);
            $("#IdUnicoV").val(data.responseJSON.data[0].idUnico);
            $("#txtNombre").text(data.responseJSON.data[0].nombre);
            $("#txtPa").text(data.responseJSON.data[0].primerAp);
            $("#txtSa").text(data.responseJSON.data[0].segundoAp);
            $("#txtGen").text(data.responseJSON.data[0].genero);
            $("#txtTel").text(data.responseJSON.data[0].telefono);
            $("#txtTelA").text(data.responseJSON.data[0].telAlt);
            $("#txtEnt").text(data.responseJSON.data[0].entidad);
            $("#txtMun").text(data.responseJSON.data[0].municipio);
            $("#txtLoc").text(data.responseJSON.data[0].localidad);
            $("#txtCalle").text(data.responseJSON.data[0].calle);
            $("#txtNuEx").text(data.responseJSON.data[0].numeroExt);
            $("#txtNuIn").text(data.responseJSON.data[0].numeroInt);
            $("#txtCol").text(data.responseJSON.data[0].colonia );
            $("#txtCp").text(data.responseJSON.data[0].cp);
            $("#txtRef").text(data.responseJSON.data[0].referencia);
            // data.responseJSON.data[0].prueba == "NO" ? $("#rp2").attr('checked', 'checked'):$("#rp1").attr('checked', 'checked');
            // $("#Esquema").val(data.responseJSON.data[0].esquema == null ? 1 : data.responseJSON.data[0].esquema);
            // $("#Identificador").val(data.responseJSON.data[0].identificador);
            if(data.responseJSON.data[0].idUnico != null && data.responseJSON.data[0].prueba ==null){
                $("#capOp").show();
                $("#btnCaptacion").removeAttr("disabled");
            }

            if(data.responseJSON.data[0].idUnico != null && data.responseJSON.data[0].prueba != null){
                if(data.responseJSON.data[0].nuVisita == 0){
                    $("#NuVisita").val(1);
                    $("#lblNV").text("Visita 1");
                }
                else{
                    $("#NuVisita").val(2);
                    $("#lblNV").text("Visita 2");
                }
                if(data.responseJSON.data.length !=2){
                    $("#capVi").show();
                    $("#btnV1").removeAttr("disabled");
                }
                
            } 
            // Respuestas
            $("#rPrueba").val(data.responseJSON.data[0].prueba);
            $("#rEsquema").val(data.responseJSON.data[0].esquema);
            $("#rIdentificador").val(data.responseJSON.data[0].identificador);
            // Visita 1
            if(data.responseJSON.data[0].localizo != null){
            $("#rFechaPro").val($.date(data.responseJSON.data[0].fchProgramacion));
            $("#rLocalizo").val(data.responseJSON.data[0].localizo);
            $("#rAcordo").val(data.responseJSON.data[0].acordo);
            $("#rFechaAc").val($.date(data.responseJSON.data[0].fchAcordada));
            $("#rLugar").val(data.responseJSON.data[0].lugar);
            $("#rMotivo").val(data.responseJSON.data[0].motivo);
            }
            // Visita 2
            if(data.responseJSON.data.length == 2){
            $("#rFechaPro2").val($.date(data.responseJSON.data[1].fchProgramacion));
            $("#rLocalizo2").val(data.responseJSON.data[1].localizo);
            $("#rAcordo2").val(data.responseJSON.data[1].acordo);
            $("#rFechaAc2").val($.date(data.responseJSON.data[1].fchAcordada));
            $("#rLugar2").val(data.responseJSON.data[1].lugar);
            $("#rMotivo2").val(data.responseJSON.data[1].motivo);
            }
        },
        error: function(jqXHR, textStatus, errorThrown) {
          // $("#postResult").val(jqXHR.statusText);
        }
      });
    });
