@model ConaviWeb.Model.Request.UserRequest
@{
    Layout = "_LayoutSedatu";
    ViewBag.Title = "Login";
}
<style type="text/css">
    :root {
        --gobmx-primary: #611232;
        --gobmx-primary-dark: #4b0e27;
        --gobmx-gray: #545454;
        --gobmx-gray-light: #f5f5f5;
        --gobmx-border: #d8d8d8;
        --gobmx-focus: rgba(97,18,50,.35);
        --radius: .75rem;
    }

    .login-wrapper {
        min-height: calc(100vh - 90px);
        background: var(--gobmx-gray-light);
        display: flex;
        flex-direction: column;
    }

    .login-grid {
        flex: 1;
        display: grid;
        grid-template-columns: clamp(320px,40%,520px) 1fr;
        min-height: 100%;
    }

    @@media (max-width: 992px) {
        .login-grid {
            grid-template-columns: 1fr;
        }

        .login-hero {
            display: none;
        }
    }

    .login-panel {
        background: #ffffff;
        border-right: 1px solid var(--gobmx-border);
        padding: clamp(2rem,5vw,3rem);
        display: flex;
        flex-direction: column;
    }

    @@media (max-width:992px) {
        .login-panel {
            border-right: none;
            border-bottom: 1px solid var(--gobmx-border);
        }
    }

    .login-card {
        background: #fff;
        border: 1px solid var(--gobmx-border);
        border-radius: var(--radius);
        box-shadow: 0 4px 14px -2px rgba(0,0,0,.12);
        padding: 1.75rem 1.5rem 1.25rem;
    }

    .login-hero {
        background: linear-gradient(135deg,var(--gobmx-primary),var(--gobmx-primary-dark));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3rem 2.5rem;
    }

    .login-hero-content {
        max-width: 480px;
    }

    .login-hero h2 {
        font-weight: 600;
        letter-spacing: .5px;
    }

    .badge-primary-gob {
        background: var(--gobmx-primary-dark);
        font-weight: 500;
    }

    .form-floating {
        position: relative;
        margin-bottom: 2.1rem;
    }

    .form-floating .form-control {
        border: 1px solid var(--gobmx-border);
        background: #fff;
        color: #222;
    }

    .form-floating .form-control:focus {
        border-color: var(--gobmx-primary);
        box-shadow: 0 0 0 .15rem var(--gobmx-focus);
    }

    .form-floating label {
        color: #666;
    }

    .form-floating .field-validation-error,
    .form-floating span.text-danger,
    .form-floating span.text-warning {
        position: absolute;
        left: 0;
        bottom: -1rem;
        font-size: .7rem;
        line-height: 1;
        color: #c62828 !important;
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        pointer-events: none;
    }

    .toggle-wrapper {
        position: absolute;
        top: 50%;
        right: .65rem;
        transform: translateY(-50%);
        cursor: pointer;
        color: #777;
    }

    .toggle-wrapper:hover {
        color: var(--gobmx-primary);
    }

    .btn-primary {
        background: var(--gobmx-primary);
        border-color: var(--gobmx-primary);
    }

    .btn-primary:hover,
    .btn-primary:focus {
        background: var(--gobmx-primary-dark);
        border-color: var(--gobmx-primary-dark);
    }

    .link-em {
        color: var(--gobmx-primary);
        text-decoration: none;
    }

    .link-em:hover {
        text-decoration: underline;
        color: var(--gobmx-primary-dark);
    }

    .small-muted {
        color: #6c6c6c;
    }

    .footer-mini {
        font-size: .7rem;
        color: var(--gobmx-gray);
        text-align: center;
        margin-top: 1.25rem;
    }

    .alert-danger {
        font-size: .75rem;
        padding: .5rem .75rem;
    }
</style>
