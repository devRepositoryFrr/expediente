<div class="login-wrapper">
    <div class="login-grid">
        <!-- Panel (Formulario) -->
        <div class="login-panel">
            <div class="mb-4 text-center">
                <a href="https://www.gob.mx/conavi" class="text-decoration-none">
                    <i class="icon-cnv red-ic" style="font-size:72px;"></i>
                </a>
                <h1 class="h5 mt-3 mb-1 text-dark fw-semibold">Acceso al Sistema</h1>
                <p class="text-muted small mb-0">Ingrese sus credenciales para continuar</p>
            </div>

            @Html.Raw(ViewBag.Alert)

            <div class="login-card text-dark">
                <form method="post" asp-action="Auth" id="frmLogin" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="valSummary"></div>

                    <div class="form-floating">
                        <input asp-for="SUser" class="form-control" placeholder="Usuario" autocomplete="username" required />
                        <label asp-for="SUser">Usuario</label>
                        <span asp-validation-for="SUser" class="text-danger"></span>
                    </div>

                    <div class="form-floating">
                        <input asp-for="Password" type="password" class="form-control" placeholder="Contraseña" autocomplete="current-password" id="txtPassword" required />
                        <label asp-for="Password">Contraseña</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                        <span class="toggle-wrapper" id="togglePwd" aria-label="Mostrar / Ocultar contraseña">
                            <i class="fa fa-eye-slash"></i>
                        </span>
                    </div>

                    <button class="btn btn-primary w-100 d-inline-flex justify-content-center align-items-center gap-2 mb-3" type="submit" id="btnLogin">
                        <span class="spinner-border spinner-border-sm d-none" id="spinner" role="status" aria-hidden="true"></span>
                        <i class="fa fa-sign-in"></i>
                        <span>Iniciar Sesión</span>
                    </button>
                </form>
            </div>

            <div class="footer-mini">
                Uso autorizado únicamente • @DateTime.Now.Year
            </div>
        </div>

        <!-- Hero informativo -->
        <div class="login-hero">
            <div class="login-hero-content">
                <span class="badge badge-primary-gob mb-3">Operación Interna</span>
                <h2 class="h3 mb-3">Sistema de Control de Expedientes Conavi</h2>
                <p class="mb-3">
                    Plataforma para la gestión de inventarios y control de expedientes.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="https://www.gob.mx/conavi" target="_blank" class="btn btn-outline-light btn-sm">Portal CONAVI</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}}
<script>
    document.addEventListener('DOMContentLoaded', function () {

        const frm      = document.getElementById('frmLogin');
        const btn      = document.getElementById('btnLogin');
        const spinner  = document.getElementById('spinner');
        const summary  = document.getElementById('valSummary');
        const togglePwd= document.getElementById('togglePwd');
        const txtPwd   = document.getElementById('txtPassword');

        // Toggle password
        if (togglePwd && txtPwd) {
            togglePwd.addEventListener('click', () => {
                const show = txtPwd.type === 'password';
                txtPwd.type = show ? 'text' : 'password';
                const icon = togglePwd.querySelector('i');
                if (icon) {
                    icon.classList.toggle('fa-eye', show);
                    icon.classList.toggle('fa-eye-slash', !show);
                }
            });
        }

        if (!frm) return;

        if (window.jQuery && $.validator && $.validator.unobtrusive) {
            $.validator.unobtrusive.parse(frm);
        }

        const $form = $(frm);
        let submitting = false;

        $form.on('invalid-form.validate', function () {
            if (btn) btn.disabled = false;
            spinner.classList.add('d-none');
            //summary.classList.remove('d-none');
            //summary.innerHTML = '<i class="fa fa-exclamation-circle"></i> Revise los campos.';
            submitting = false;
        });

        $form.on('submit', function (e) {
            if (submitting) { e.preventDefault(); return false; }
            if (!$form.valid()) { e.preventDefault(); return false; }

            if(togglePwd.ariaValueMax=='' || document.getElementById("SUser").value==''){
                summary.innerHTML = '<i class="fa fa-exclamation-circle"></i> Revise los campos.';
                submitting = false;
            }
            submitting = true;
            btn.disabled = true;
            spinner.classList.remove('d-none');
            //summary.classList.add('d-none');
        });

        if (frm.querySelectorAll('.input-validation-error').length > 0) {
            //summary.classList.remove('d-none');
            summary.innerHTML = '<i class="fa fa-exclamation-circle"></i> Revise los campos.';
        }
    });
    $(document).ready(function () {
        showAlert();
    });
    $(window).on('beforeunload', function () {
        console.log("before");

        $('.spinner').css('display', 'block');
    });

    function showAlert() {

        setTimeout(function () {
            $("#alerta").fadeOut(1500);

        }, 3000);
        setTimeout(function () {

            $("#alerta").remove();
        }, 6000);

    }
</script>