@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
<script type="text/javascript">
        const urlParams = new URLSearchParams(window.location.search);
        const idPredio = urlParams.get('id');
        if (idPredio != null) {
            getPropuesta(idPredio);
        }
        $(document).ready(function () {
            showAlerta();
            $("[name='IdPredio']").val(idPredio);
            $("#slc_ejfiscal").on("change", function () {
                $('#spinner').show();
                var data = new FormData();
                data.append("ejFiscal", this.value);
                $.ajax({
                    type: "post",
                    url: "@Url.Action("GetEdosPrediosList", "Levantamiento")", // Url
                    data: data,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $('#spinner').hide();
                        if (result.data != null) {
                            $("#slc_edo").html("<option>- Seleccione -</option>")
                            $(result.data).each(function () {
                                $("#slc_edo").append("<option value='"+ this.clave +"'>" + this.descripcion + "</option>")
                            });
                        }
                    }
                });
            });
            $("[name='SuperficieTerreno'],[name='SuperficieDesplante'],[name='SuperficieDonacion'],[name='SuperficieEquipamiento'],[name='SuperficieRecreativa'],[name='SuperficieRestriccion'],[name='SuperficieAreasVerdes'],[name='SuperficieCirculacionesVehiculares'],[name='SuperficieCirculacionesPeatonales'],[name='SuperficieCajonesEstacionamiento']").on("keyup", function () {
                $("#txt_percentage_desplante").val((($("[name='SuperficieDesplante']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_donacion").val((($("[name='SuperficieDonacion']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_equipamiento").val((($("[name='SuperficieEquipamiento']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_recreativa").val((($("[name='SuperficieRecreativa']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_restriccion").val((($("[name='SuperficieRestriccion']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_areasverdes").val((($("[name='SuperficieAreasVerdes']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_circulaciones_vehiculares").val((($("[name='SuperficieCirculacionesVehiculares']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_circulaciones_peatonales").val((($("[name='SuperficieCirculacionesPeatonales']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_estacionamiento").val((($("[name='SuperficieCajonesEstacionamiento']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
            });
            $("[name='TotalViviendas'],[name='ViviendasUnifamiliar'],[name='ViviendasMultifamiliar'],[name='ViviendasRenta']").on("keyup", function () {
                $("#txt_percentage_vivienda_unifamiliar").val((($("[name='ViviendasUnifamiliar']").val() / $("[name='TotalViviendas']").val()) * 100).toFixed(2));
                $("#txt_percentage_vivienda_multifamiliar").val((($("[name='ViviendasMultifamiliar']").val() / $("[name='TotalViviendas']").val()) * 100).toFixed(2));
                $("#txt_percentage_vivienda_renta").val((($("[name='ViviendasRenta']").val() / $("[name='TotalViviendas']").val()) * 100).toFixed(2));
            });
            $("#formInsertPropuestaConceptual").submit(function (e) {
                $("[name='NivelesViviendasUnifamiliar']").val($("#slc_niveles_vivienda_unifamiliar").val());
                $("[name='NivelesViviendasMultifamiliar']").val($("#slc_niveles_vivienda_multifamiliar").val());
                $("[name='NivelesViviendasRenta']").val($("#slc_niveles_vivienda_renta").val());
                return true;
            });
        });
        function getPropuesta(id) {
            var data = new FormData();
            data.append("idPredio", id);
            $.ajax({
                type: "post",
                url: "@Url.Action("GetPropuestaConceptual", "Levantamiento")", // Url
                data: data,
                processData: false,
                contentType: false,
                success: function (result) {
                    $('#spinner').hide();
                    if (result.id != null) {
                        result.archivoCriterios!= null ? $("#btn_criterios_tecnicos").prop("disabled", false).removeClass("disabled").on("click", function () { window.open('https://' + window.location.host + '/Levantamiento/doc/PrediosAdquisicion/' + idPredio + '/CriteriosTecnicos/' + result.archivoCriterios, '_blank').focus(); }) : '';
                        $("[name='SuperficieTerreno']").val(result.superficieTerreno);
                        $("[name='SuperficieDesplante']").val(result.superficieDesplante);
                        $("[name='SuperficieDonacion']").val(result.superficieDonacion);
                        $("[name='SuperficieEquipamiento']").val(result.superficieEquipamiento);
                        $("[name='SuperficieConstruccion']").val(result.superficieConstruccion);
                        $("[name='SuperficieRestriccion']").val(result.superficieRestriccion);
                        $("[name='SuperficieRecreativa']").val(result.superficieRecreativa);
                        $("[name='SuperficieAreasVerdes']").val(result.superficieAreasVerdes);
                        $("[name='SuperficieCirculacionesVehiculares']").val(result.superficieCirculacionesVehiculares);
                        $("[name='SuperficieCirculacionesPeatonales']").val(result.superficieCirculacionesPeatonales);
                        $("[name='CajonesEstacionamiento']").val(result.cajonesEstacionamiento);
                        $("[name='SuperficieCajonesEstacionamiento']").val(result.superficieCajonesEstacionamiento);
                        $("[name='TotalViviendas']").val(result.totalViviendas);
                        $("[name='ViviendasUnifamiliar']").val(result.viviendasUnifamiliar);
                        $("[name='ViviendasMultifamiliar']").val(result.viviendasMultifamiliar);
                        $("[name='ViviendasRenta']").val(result.viviendasRenta);
                        $("[name='SuperficieViviendasUnifamiliar']").val(result.superficieViviendasUnifamiliar);
                        $("[name='SuperficieViviendasMultifamiliar']").val(result.superficieViviendasMultifamiliar);
                        $("[name='SuperficieViviendasRenta']").val(result.superficieViviendasRenta);
                        if (result.nivelesViviendasUnifamiliar != null) {
                            $(result.nivelesViviendasUnifamiliar.split(',')).each(function () {
                                $("#slc_niveles_vivienda_unifamiliar option[value=" + this + "]").prop("selected", true);
                            });
                        }
                        if (result.nivelesViviendasMultifamiliar != null) {
                            $(result.nivelesViviendasMultifamiliar.split(',')).each(function () {
                                $("#slc_niveles_vivienda_multifamiliar option[value=" + this + "]").prop("selected", true);
                            });
                        }
                        if (result.nivelesViviendasRenta != null) {
                            $(result.nivelesViviendasRenta.split(',')).each(function () {
                                $("#slc_niveles_vivienda_renta option[value=" + this + "]").prop("selected", true);
                            });
                        }
                        $("#Estatus option[value=" + result.estatus + "]").prop("selected", true);
                        $("[name='ObservacionesEstatus']").val(result.observacionesEstatus);
                        result.archivoPropuesta != null ? $("#btn-download-pc").prop("disabled", false).removeClass("disabled").on("click", function () { window.open('https://' + window.location.host + '/Levantamiento/doc/PrediosAdquisicion/' + idPredio + '/PropuestaConceptual/' + result.archivoPropuesta, '_blank').focus(); }) : '';
                        $("[name='EstatusPropuesta'] option[value=" + result.claveEstatusPropuesta + "]").prop("selected", true);
                        $("[name='ObservacionesPropuesta']").val(result.observacionesPropuesta);
                        result.archivoConciliacion != null ? $("#btn-download-conciliacion").prop("disabled", false).removeClass("disabled").on("click", function () { window.open('https://' + window.location.host + '/Levantamiento/doc/PrediosAdquisicion/' + idPredio + '/Conciliacion/' + result.archivoConciliacion, '_blank').focus(); }) : '';
                        $("[name='TotalViviendasFinal']").val(result.totalViviendasFinal);
                        $("[name='TotalCajonesEstacionamiento']").val(result.totalCajonesEstacionamiento);
                        if (result.nivelesVivienda != null) {
                            $(result.nivelesVivienda.split(',')).each(function () {
                                //$("[name='NivelesVivienda'] option[value=" + result.nivelesVivienda + "]").prop("selected", true);
                                $("#slc_niveles_vivienda option[value=" + this + "]").prop("selected", true);
                            });
                        }
                    } else {
                        $("#alert").html(result).fadeIn("slow");
                        showAlert("alert");
                    }
                }
            }).then(function (){
                $("[name='SuperficieTerreno'],[name='SuperficieDesplante'],[name='SuperficieDonacion'],[name='SuperficieEquipamiento'],[name='SuperficieRecreativa'],[name='SuperficieRestriccion'],[name='SuperficieAreasVerdes'],[name='SuperficieCirculacionesVehiculares'],[name='SuperficieCirculacionesPeatonales'],[name='SuperficieCajonesEstacionamiento'],[name='TotalViviendas'],[name='ViviendasUnifamiliar'],[name='ViviendasMultifamiliar'],[name='ViviendasRenta']").trigger("keyup");
            });
        }
        function uploadCriterios() {
            if ($("#criterios_tecnicos")[0].files[0] != null && idPredio != 0 && idPredio != null) {
                $('#spinner').show();
                var data = new FormData();
                @*let idSedatu = $("#idSedatu").val();*@
                let json = JSON.stringify({ idPredio: idPredio });
                data.append("json", json);
                data.append('file', $("#criterios_tecnicos")[0].files[0]);
                $.ajax({
                    type: "post",
                    url: "@Url.Action("UploadCriteriosTecnicos", "Levantamiento")", // Url
                    data: data,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        $('#spinner').hide();
                        $("#alertCriterios").html(data.message).fadeIn("slow");
                        GetFile();
                        showAlert("alertCriterios");
                    }
                });
            } else {
                $("#criterios_tecnicos").focus();
            }
        }
        function UploadPCFile() {
            let obs = $("[name='ObservacionesPropuesta']").val();
            let est = $("[name='EstatusPropuesta']").val();
