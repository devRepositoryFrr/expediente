        function UploadTotalFinal() {
            let totViv = $("[name='TotalViviendasFinal']").val();
            let totCaj = $("[name='TotalCajonesEstacionamiento']").val();
            $("[name='NivelesVivienda']").val($("#slc_niveles_vivienda").val())
            let totNiv = $("[name='NivelesVivienda']").val();
            if (totViv == '' || totCaj == '' || totNiv == '' || idPredio == '') {
                $("#alertTotalFinal").html('<div class="alert alert-warning" role="alert">Necesitas ingresar los valores!</div>').fadeIn("slow");
                showAlert("alertTotalFinal");
            } else {
                $('#spinner').show();
                var data = new FormData();
                let json = JSON.stringify({ idPredio: idPredio, viviendas: totViv, cajones: totCaj, niveles: totNiv });
                data.append("json", json);
                @*data.append('file', $("#propuesta-file")[0].files[0]);*@
                $.ajax({
                    type: "post",
                    url: "@Url.Action("UploadTotalPropuesta", "Levantamiento")", // Url
                    data: data,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        $('#spinner').hide();
                        $("#alertTotalFinal").html(data.message).fadeIn("slow");
                        getPropuesta(idPredio);
                        showAlert("alertTotalFinal");
                    }
                });
            }
        }
        function GetFile() {
            $('#spinner').show();
            var data = new FormData();
            data.append("idPredio", idPredio);
            $.ajax({
                type: "post",
                url: "@Url.Action("GetCriteriosTecnicos", "Levantamiento")", // Url
                data: data,
                processData: false,
                contentType: false,
                success: function (result) {
                    $('#spinner').hide();
                    if (result.data != null)
                        $("#btn_criterios_tecnicos").prop("disabled", false).removeClass("disabled").on("click", function () { window.open('https://' + window.location.host + '/Levantamiento/doc/PrediosAdquisicion/' + idPredio + '/CriteriosTecnicos/' + result.data.descripcion, '_blank').focus(); });
                }
            });
        }
        function showAlert(id) {
            setTimeout(function () {
                $("#" + id).slideToggle(1500);
            }, 4000);
            setTimeout(function () {
                $("#" + id).slideUp(1500);
            }, 6000);
        }
        function showAlerta() {
            setTimeout(function () {
                $("#alert").slideToggle(1500);
            }, 4000);
            setTimeout(function () {
                $("#alert").slideUp(1500);
            }, 6000);
        }
</script>
