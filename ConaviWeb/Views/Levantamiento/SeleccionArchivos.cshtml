@model ConaviWeb.Model.Levantamiento.Predio
@{
    Layout = "_LayoutSedatu";
    ViewData["Title"] = "Requerimiento de archivos";
}
<div class="row">
    <div class="col-md-12" id="alerta">
        @Html.Raw(@ViewBag.Alert)
    </div>
</div>
<div id="general">
    @*<div class="row">
        <div class="col-md-12 center-block">
            <img src="../img/encab2021.png" class="img-responsive" />
        </div>
    </div>
    <br />*@
    <div class="row">
        <div class="col-md-12 text-center">
            <h3>
                Selección de Archivos para Requerimientos Generales de Gestión para los Predios de Interés
            </h3>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <h3>Nombre del Proyecto: @ViewData["NombreProyecto"]</h3>
        </div>
    </div>
    <input type="hidden" asp-for="Id" id="idPredio" value="0" />
    @foreach (var seccion in (IEnumerable<ConaviWeb.Model.Catalogo>)ViewData["Seccion"])
    {
        @if (seccion.Id == 2)
        {
            <div class="row" style="background-color: #56242A;color:white;">
                <div class="col-md-12 text-center">
                    <label>Consideraciones Generales para los Procesos de Gestión en Conjuntos Habitacionales</label>
                </div>
            </div>
        }
        @if (seccion.Id == 5)
        {
            <div class="row" style="background-color: #56242A;color:white;">
                <div class="col-md-12 text-center">
                    <label>Procesos de Gestión con Dependencias/Organismos/Instituciones Estatales/Federales</label>
                </div>
            </div>
        }
        <div class="row form-group" style="background-color: #9D2449; color: white;">
            <div class="col-md-12 text-center">
                <label>@seccion.Descripcion</label>
            </div>
        </div>
        @foreach (var archivo in (IEnumerable<ConaviWeb.Model.Levantamiento.Archivo>)ViewData["Archivo"])
        {
            @if (seccion.Id == archivo.IdSeccion)
            {
                <div class="row form-group-sm">
                    <div class="mb-3 col-md-7">
                        <label for="formFile" class="form-label">@archivo.ArchivoH</label>
                    </div>
                    <div class="mb-3 col-md-3 d-flex justify-content-center">
                        <span id="div_status@($"{archivo.Id}")"></span>
                    </div>
                    <div class="mb-3 col-md-2 d-flex justify-content-center">
                        <button class="btn btn-success btn-sm" id="btn-req@($"{archivo.Id}")" onclick="Requerir(@archivo.Id,1)">Requerir <span class="fa fa-check-square-o"></span></button>
                        <button class="btn btn-danger btn-sm" id="btn-noreq@($"{archivo.Id}")" onclick="Requerir(@archivo.Id,2)">No requerir <span class="fa fa-window-close-o"></span></button>
                    </div>
                </div>
            }
        }
    }
    @*Fin de los archivos para selección*@
    <hr />
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script type="text/javascript">
        const urlParams = new URLSearchParams(window.location.search);
        const idPredio = urlParams.get('id');
        $(document).ready(function () {
            showAlert();
            @*$(".breadcrumb").html("<li><i class='fa fa-home'></i></li><li><a href='@Url.Action("Index","Levantamiento")'>Lista de predios</a></li>");*@
            if (idPredio != 0 && idPredio != null) {
                $("span").each(function () {
                    $('#btn-noreq' + this.id.slice(10)).hide();
                    GetFile(this.id.slice(10));
                });
            }
        });
        function showAlert() {
            setTimeout(function () {
                $("#alerta").slideToggle(1500);
            }, 4000);
            setTimeout(function () {
                $("#alerta").slideUp(1500);
            }, 6000);
        }
        function GetFile(idFile) {
            $('#spinner').show();
            var data = new FormData();
            data.append("idPredio", idPredio);
            data.append("idFile", idFile);
            $.ajax({
                type: "post",
                url: "@Url.Action("GetEstatusReqFile", "Levantamiento")", // Url
                data: data,
                processData: false,
                contentType: false,
                success: function (result) {
                    $('#spinner').hide();
                    if (result.data != null) {
                        result.data.clave != null ? $("#div_status" + idFile).html(' <b>(' + result.data.clave + ')</b>') : '';
                        $('#btn-req' + idFile + ',#btn-noreq' + idFile).hide();
                        result.data.clave == 'Requerido' ? $('#btn-noreq' + idFile).show() : $('#btn-req' + idFile).show();
                    }
                }
            });
        }
        function Requerir(idFile,estatus) {
            $('#spinner').show();
            var data = new FormData();
            data.append("idPredio", idPredio);
            data.append("idFile", idFile);
            data.append("estatus", estatus);
            $.ajax({
                type: "post",
                url: "@Url.Action("RequerirArchivo", "Levantamiento")", // Url
                data: data,
                processData: false,
                contentType: false,
                success: function (data) {
                    $('#spinner').hide();
                    if (data.success == false) {
                        $("#alerta").html(data.message).fadeIn("slow");
                        showAlert();
                    }
                    GetFile(idFile);
                }
            });
        }
    </script>
}