@{
    ViewData["Title"] = "Inventario";
}
@********************************************************************************************************************************************************************@
@*Formulario para el el Inventario de Transferencia Primaria al Archivo de Concentración*@
<div id="general">
    <div class="row">
        <div class="col-md-5 center-block">
            <img src="~/img/logo_header25.png" class="img-responsive" />
        </div>
        <div class="col-md-7 text-right">
            <label>
                SUBDIRECCIÓN GENERAL DE ADMINSTRACIÓN Y FINANCIAMIENTO<br />
                DIRECCIÓN DE ADMINISTRACIÓN DE RECURSOS<br />
                DEPARTAMENTO DE UNIDADES DOCUMENTALES
            </label>
        </div>
    </div>
    <br />
    <div class="row form-group">
        <div class="col-md-12 text-center">
            <label>
                Inventario de Transferencia Primaria al Archivo de Concentración
            </label>
        </div>
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-4">
                    <label class="control-label">Nombre de la Unidad Administrativa generadora:</label>
                </div>
                <div class="col-md-8">
                    <label class="form-control" id="unidadAdministrativa">Aquí aparecerá la unidad administrativa ligada al usuario</label>
                </div>
            </div>
        </div>
    </div>
    <div class="row form-group datepicker-group">
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-6">
                    <label for="felaboracion_inventario">Fecha de elaboración del inventario:</label>
                </div>
                <div class="col-md-6">
                    <label id="felaboracion_inventario" class="form-control"></label>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="row">
                <div class="col-md-6">
                    <label for="ftransferencia_inventario">Fecha de transferencia al Archivo de Concentración:</label>
                </div>
                <div class="col-md-6">
                    <label id="ftransferencia_inventario" class="form-control"></label>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <label class="control-label" for="responsableArchivo">Nombre del responsable del archivo de trámite:</label>
        </div>
        <div class="col-md-8">
            <label class="form-control" id="responsableArchivo">Aquí aparecerá el nombre del responsable</label>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <form id="formTable">
                <table id="tableExpTP" class="table">
                    <thead>
                        <tr>
                            <th>
                                No. Prog.
                            </th>
                            <th>
                                Cve del Expediente
                            </th>
                            <th>
                                Nombre del Expediente
                            </th>
                            <th>
                                Periodo
                            </th>
                            <th>
                                Cantidad en años de resguardo en el archivo de concentración
                            </th>
                            <th>
                                No. de Legajos
                            </th>
                            <th>
                                No. de Fojas
                            </th>
                            <th>
                                Observaciones
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </form>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <form id="formTable">
                <table id="table" class="table text-center">
                    <thead>
                        <tr>
                            <td style="width: 25%">
                                Responsable de la custodia
                            </td>
                            <td style="width: 25%">
                                Entrega
                            </td>
                            <td style="width: 25%">
                                Recibe Responsable del Archivo de Concentración
                            </td>
                            <td style="width: 25%">
                                Vo.Bo. del Departamento de Unidades Documentales
                            </td>
                        </tr>
                        <tr>
                            <td><br /><br /><br /><br /></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>
                                <input type="text" class="form-control" id="txt_name_resp" placeholder="Responsable de la custodia" />
                                Nombre y firma
                            </td>
                            <td>
                                <input type="text" class="form-control" id="txt_name_entrega" placeholder="Persona que entrega" />
                                Nombre y firma
                            </td>
                            <td>
                                <input type="text" class="form-control" id="txt_name_recibe" placeholder="Responsable del archivo de concentración" />
                                Nombre y firma
                            </td>
                            <td>
                                <input type="text" class="form-control" id="txt_name_vobo" placeholder="VoBo del departamento de unidades documentales" />
                                Nombre y firma
                            </td>
                        </tr>
                    </thead>
                </table>
            </form>
        </div>
    </div>
    @*Fin del formulario para el alta de expediente*@
    <hr />
    <button class="btn btn-primary form-control" onclick="generarPDF()">Imprimir</button>
</div>
<!-- jsPDF y html2canvas -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/3.0.3/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script type="text/javascript">
        const urlParams = new URLSearchParams(window.location.search);
        const idInv = urlParams.get('id');
        $(document).ready(function () {
            showAlert();
            $.ajax({
                url: "@Url.Action("GetInventarioControlById", "InventarioControl")", // Url
                data: {
                    // Datos / Parámetros
                    Id: idInv
                },
                type: "post"  // Verbo HTTP
            }).done(function (result) {
                if (result.id != null) {
                    $('#unidadAdministrativa').text(result.nombrePuesto);
                    $('#responsableArchivo').text(result.nombreResponsableAT);
                    $('#felaboracion_inventario').text(result.fechaElaboracion != null ? result.fechaElaboracion.substring(8, 10) + '/' + result.fechaElaboracion.substring(5, 7) + '/' + result.fechaElaboracion.substring(0, 4) : '');
                    $('#ftransferencia_inventario').text(result.fechaTransferencia != null ? result.fechaTransferencia.substring(8, 10) + '/' + result.fechaTransferencia.substring(5, 7) + '/' + result.fechaTransferencia.substring(0, 4) : '');

                    var urlTipo = "";
                    urlTipo = "@Url.Action("GetExpedientesTPByIdInv", "Inventario")";
                    table = $('#tableExpTP').DataTable({
                        "proccessing": true,
                        "serverSide": false,
                        "ajax": {
                            url: urlTipo,
                            data: { Id : idInv },
                            type: 'POST',
                            headers: { 'RequestVerificationToken': $('@Html.AntiForgeryToken()').val() },
                            complete: function () {
                                $("#spinner").hide();
                            }
                        },
                        "columnDefs": columns,
                        "order": [[0, "desc"]],
                        "autoWidth": true,
                        "destroy": true,
                        "scrollY": true,
                        "scrollCollapse": true,
                        "paging": false,
                        "searching": false,
                        "info": false,
                        "scrollX": true,
                        "fixedColumns": true,
                        "ordering": false,
                        "language": {
                            "sProcessing": "Procesando...",
                            "sLengthMenu": "Mostrar _MENU_ registros",
                            "sZeroRecords": "No se encontraron resultados",
                            "sEmptyTable": "Ningún dato disponible en esta tabla",
                            "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                            "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                            "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                            "sInfoPostFix": "",
                            "sSearch": "Buscar:",
                            "sUrl": "",
                            "sInfoThousands": ",",
                            "sLoadingRecords": "Cargando...",
                            "oPaginate": {
                                "sFirst": "Primero",
                                "sLast": "Último",
                                "sNext": "Siguiente",
                                "sPrevious": "Anterior"
                            }
                        }
                    });
                } else {
                    $("#alertAjax").append(result);
                    showAlert();
                }
            })
            // Se ejecuta si se produjo un error.
            .fail(function (xhr, status, error) {
                // Mostramos un mensaje de error.
                //$("#ErrorAlert").show("slow").delay(2000).hide("slow");
            })
            // Hacer algo siempre, haya sido exitosa o no.
            .always(function () {

            });

        });
        var columns = [
            { "name": "NoProg", "data": "noProg", "targets": 0 },
            {
                "targets": 1,
                "data": null,
                "render": function (data, type, row, meta) {
                    var ret = row.codigo + '-' + row.consecutivo + '/' + row.periodo;
                    return ret;
                },
                "sortable": false,
                "className": 'text-center'
            },
            { "name": "Nombre", "data": "nombre", "targets": 2 },
            { "name": "Periodo", "data": "periodo", "targets": 3 },
            { "name": "AniosResguardo", "data": "aniosResguardo", "targets": 4 },
            { "name": "Legajos", "data": "legajos", "targets": 5 },
            { "name": "Fojas", "data": "fojas", "targets": 6 },
            { "name": "Observaciones", "data": "observaciones", "targets": 7 },
        ];
        function showAlert() {
            setTimeout(function () {
                $("#alerta").fadeOut(1500);
            }, 3000);
            setTimeout(function () {
                $("#alerta").remove();
            }, 6000);
        }
        function generarPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({
                orientation: 'landscape',
                unit: 'mm',
                format: 'a4',
                setFont: 'Noto Sans'
            });

            // Tabla principal
            const table = document.getElementById('tableExpTP');
            const headers = [];
            $(table).find('thead th').each(function () {
                headers.push($(this).text().trim());
            });
            const data = [];
            // for (var t = 0; t < 145; t++) {
                $(table).find('tbody tr').each(function () {
                    const row = [];
                    $(this).find('td').each(function () {
                        row.push($(this).text().trim());
                    });
                    if (row.length > 0) data.push(row);
                });
            // }
            // Prepara el footer de firmas
            const firmasFooter = [
                [
                    {content: 'Responsable de la custodia', colSpan:2, styles: { cellWidth: 23.6, minCellHeight: 30}},
                    {content: 'Entrega', colSpan: 2, styles: { cellWidth: 23.6, minCellHeight: 30 }},
                    {content: 'Recibe Responsable del Archivo de Concentración', colSpan: 2, styles: { cellWidth: 23.6, minCellHeight: 30 }},
                    {content: 'Vo.Bo. del Departamento de Unidades Documentales', colSpan: 2, styles: { cellWidth: 23.6, minCellHeight: 30 }}
                ],
                [
                    {content: '____________________________', colSpan:2 },
                    {content: '____________________________', colSpan:2 },
                    {content: '____________________________', colSpan:2 },
                    {content: '____________________________', colSpan:2 }
                ],
                [
                    {content: $('#txt_name_resp').val() || '', colSpan: 2 },
                    {content: $('#txt_name_entrega').val() || '', colSpan: 2 },
                    {content: $('#txt_name_recibe').val() || '', colSpan: 2 },
                    {content: $('#txt_name_vobo').val() || '', colSpan: 2 }
                ]
            ];

            // Paginación y tabla principal
            doc.autoTable({
                head: [headers],
                body: data,
                foot: firmasFooter,
                showFoot: 'lastPage',
                startY: 58,
                margin: { top:58, left:10, right: 10, bottom: 10 },
                styles: { fontSize: 8 },
                headStyles: { halign: 'center', valign: 'middle', fillColor: null, textColor: 20, lineWidth: 0.1 },
                footStyles: { halign: 'center', fillColor: null, textColor: 20 },
                theme: 'grid',
                didDrawPage: function (data) {
                    // Pie de página con paginación
                    var str = "Hoja " + doc.internal.getNumberOfPages() + " de {total_pages_count_string} del inventario";
                    var pageSize = doc.internal.pageSize;
                    // var pageHeight = pageSize.height ? pageSize.height : pageSize.getHeight();
                    const img = document.querySelector('img[src*="logo_header25.png"]');
                    if (img) {
                        // Si la imagen está cargada, la agregamos
                        // Necesitas convertir la imagen a base64 si no está en el DOM como base64
                        // Aquí se asume que está disponible
                        doc.addImage(img.src, 'PNG', 10, 10, 124, 18);
                    }
                    doc.setFontSize(10);
                    doc.setFont("helvetica", "bold");
                    doc.text('SUBDIRECCIÓN GENERAL DE ADMINSTRACIÓN Y FINANCIAMIENTO', 170, 15);
                    doc.text('DIRECCIÓN DE ADMINISTRACIÓN DE RECURSOS', 202, 20);
                    doc.text('DEPARTAMENTO DE UNIDADES DOCUMENTALES', 201, 25);
                    // doc.setFontSize(12);
                    doc.text('Inventario de Transferencia Primaria al Archivo de Concentración', 100, 35);
                    doc.text(str, pageSize.width - 55, 40);
                    
                    // Datos generales
                    // doc.setFontSize(10);
                    doc.text(`Nombre de la Unidad Administrativa generadora: ${$('#unidadAdministrativa').text()}`, 10, 45);
                    doc.text(`Fecha de elaboración del Inventario: ${$('#felaboracion_inventario').text()}`, 10, 50);
                    doc.text(`Fecha de transferencia al Archivo de Concentración: ${$('#ftransferencia_inventario').text()}`, 179, 50);
                    doc.text(`Nombre del responsable del archivo de trámite: ${$('#responsableArchivo').text()}`, 10, 55);
                }
            });
            // Reemplaza el marcador de total de páginas
            if (typeof doc.putTotalPages === 'function') {
                doc.putTotalPages("{total_pages_count_string}");
            }
            doc.autoPrint({variant: 'non-conform'});
            doc.output("pdfobjectnewwindow");
            // doc.save(`InventarioTransPrimaria_id${idInv}.pdf`);
        }
        //setTimeout(function () {
        //    imprimirElemento();
        //}, 2000);
    </script>
}