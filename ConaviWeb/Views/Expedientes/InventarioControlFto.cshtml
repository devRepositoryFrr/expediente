@{
    ViewData["Title"] = "Inventario";
}
@********************************************************************************************************************************************************************@
@*Formulario para el el Inventario de Transferencia Primaria al Archivo de Concentración*@
<div id="general">
    <div class="row">
        <div class="col-md-5 center-block">
            <img src="/Expediente/img/logo_header25.png" class="img-responsive" />
        </div>
        <div class="col-md-7 text-right">
            <label>
                UNIDAD DE ADMINISTRACIÓN Y FINANZAS<br />
                DIRECCIÓN DE ADMINISTRACIÓN DE RECURSOS<br />
                DEPARTAMENTO DE UNIDADES DOCUMENTALES
            </label>
        </div>
    </div>
    <br />
    <div class="row mb-1">
        <div class="col-md-12 text-center">
            <label>
                Inventario para el control del acervo documental en los archivos de trámite
            </label>
        </div>
    </div>
    <div class="row mb-1">
        <div class="col-md-4">
            <label for="felaboracion_inventario">Fecha de elaboración del inventario:</label>
        </div>
        <div class="col-md-8">
            <label id="fechaElaboracion" class="form-control"></label>
        </div>
    </div>
    <div class="row mb-1">
        <div class="col-md-4">
            <label>Fondo:</label>
        </div>
        <div class="col-md-8">
            <label class="form-control">CONAVI</label>
        </div>
    </div>
    <div class="row mb-1">
        <div class="col-md-4">
            <label>Sección:</label>
        </div>
        <div class="col-md-8">
            <label id="Secciones" class="form-control">Todas las secciones</label>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-md-4">
            <label>Serie:</label>
        </div>
        <div class="col-md-8">
            <div id="Series" class="form-control" style="min-height:39px; height: 100%;">Todas las series</div>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-md-4">
            <label class="control-label">Unidad Administrativa:</label>
        </div>
        <div class="col-md-8">
            <div class="form-control" id="areaDescripcion" style="min-height:39px; height: 100%;">Aquí aparecerá la unidad administrativa ligada al usuario</div>
        </div>
    </div>
    <div class="row mb-2">
        <div class="col-md-4">
            <label class="control-label">Área generadora:</label>
        </div>
        <div class="col-md-8">
            <div class="form-control" id="puestoDescripcion" style="min-height:39px; height: 100%;">Aquí aparecerá la unidad administrativa ligada al usuario</div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <form id="formTable">
                <table id="tableExpControl" class="table">
                    <thead>
                        <tr>
                            <th rowspan="2">
                                No.
                            </th>
                            <th rowspan="2">
                                Código de clasificación archivística
                            </th>
                            <th rowspan="2">
                                Título del expediente
                            </th>
                            <th rowspan="2">
                                Descripción del asunto que trata cada expediente
                            </th>
                            <th colspan="2" class="text-center">
                                Fechas extremas
                            </th>
                            <th rowspan="2">
                                No. de legajos
                            </th>
                            <th rowspan="2">
                                No. de CD's y USB
                            </th>
                            <th rowspan="2">
                                No. de fojas
                            </th>
                            <th colspan="2" class="text-center">
                                Soporte documental
                            </th>
                            <th colspan="3" class="text-center">
                                Valor documental
                            </th>
                            <th colspan="3" class="text-center">
                                N° de años en el tipo de archivo
                            </th>
                            <th rowspan="2">
                                Ubicación del documento
                            </th>
                            <th rowspan="2">
                                Observaciones
                            </th>
                        </tr>
                        <tr>
                            <th>
                                Año de apertura
                            </th>
                            <th>
                                Año de cierre
                            </th>
                            <th>
                                Físico
                            </th>
                            <th>
                                Electr.
                            </th>
                            <th>
                                A
                            </th>
                            <th>
                                L
                            </th>
                            <th>
                                F/C
                            </th>
                            <th>
                                AT
                            </th>
                            <th>
                                AC
                            </th>
                            <th>
                                Total de años
                            </th>
                        </tr>
                    </thead>
                    <tbody>

                    </tbody>
                </table>
            </form>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <form id="formTable">
                <table id="table" class="table text-center">
                    <thead>
                        <tr>
                            <td colspan="4">
                                El presente inventario consta de <input type="text" size="1" id="fojas" value="1" /> foja(s) y ampara la cantidad de <u id="expedientes"></u> expediente(s) de los años <u id="anios"></u> ubicados en <u id="Ubicacion"></u> . Para los expedientes con documentos electrónicos, ampara la cantidad de <u id="PesoElectronicos"></u> (KB, MB, entre otros) almacenados en <u id="Almacenamiento"></u>.
                            </td>
                        </tr>
                        <tr>
                            <td style="width: 25%">
                                Elaboró
                            </td>
                            <td style="width: 25%">
                                Validó/Entrega
                            </td>
                            <td style="width: 25%">
                                Autorizó
                            </td>
                            <td style="width: 25%">
                                Recibe
                            </td>
                        </tr>
                        <tr>
                            <td><br /><br /><br /><br /></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>
                                <input type="text" id="txt_name_elab" class="form-control" placeholder="Nombre del servidor que elaboró el inventario" />
                                <input type="text" id="txt_cargo_elab" class="form-control" placeholder="Cargo del servidor que elaboró el inventario" />
                                Nombre, cargo y firma del servidor público que elaboró el inventario.
                            </td>
                            <td>
                                <input type="text" id="txt_name_titular" class="form-control" placeholder="Nombre del Titular del Área generadora quien valida el inventario" />
                                <input type="text" id="txt_cargo_titular" class="form-control" placeholder="Cargo del Titular del Área generadora quien valida el inventario" />
                                Nombre, cargo y firma del Titular del Área generadora quien valida el inventario.
                            </td>
                            <td>
                                <input type="text" id="txt_name_titular_dud" class="form-control" placeholder="Nombre del Titular del Departamento de Unidades Documentales" />
                                <input type="text" id="txt_cargo_titular_dud" class="form-control" placeholder="Cargo del Titular del Departamento de Unidades Documentales" />
                                Nombre, cargo y firma del Titular del Departamento de Unidades Documentales.
                            </td>
                            <td>
                                <input type="text" id="txt_name_recibe" class="form-control" placeholder="Nombre de la persona que recibe el cargo" />
                                Nombre y firma de la persona que recibe el cargo.
                            </td>
                        </tr>
                    </thead>
                </table>
            </form>
        </div>
    </div>
    @*Fin del formulario para el alta de expediente*@
    <hr />
    <button class="btn btn-primary form-control" onclick="generarPDF()">Imprimir</button>
</div>

<!-- jsPDF y html2canvas -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/3.0.3/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script type="text/javascript">
        const urlParams = new URLSearchParams(window.location.search);
        const idInv = urlParams.get('id');
        $(document).ready(function () {
            showAlert();
            $.ajax({
                url: "@Url.Action("GetInventarioControlById", "InventarioControl")", // Url
                data: {
                    // Datos / Parámetros
                    Id: idInv
                },
                type: "post"  // Verbo HTTP
            }).done(function (result) {
                if (result.id != null) {
                    $('#areaDescripcion').text(result.nombrePuesto);
                    $('#puestoDescripcion').text(result.nombreUnidadAdministrativa);
                    //$('#responsableArchivo').text(result.nombreResponsableAT);
                    $('#fechaElaboracion').text(result.fechaElaboracion != null ? result.fechaElaboracion.substring(8, 10) + '/' + result.fechaElaboracion.substring(5, 7) + '/' + result.fechaElaboracion.substring(0, 4) : '');
                    //$('#fechaEntrega').text(result.fechaEntrega != null ? result.fechaEntrega.substring(8, 10) + '/' + result.fechaEntrega.substring(5, 7) + '/' + result.fechaEntrega.substring(0, 4) : '');
                    $('#Ubicacion').text(result.ubicacion != null ? result.ubicacion : '');
                    $('#PesoElectronicos').text(result.pesoElectronico);
                    $('#Almacenamiento').text(result.almacenamiento != null ? result.almacenamiento : '');
                    $('#Secciones').text(result.secciones!=null ? result.secciones : '');
                    $('#Series').text(result.series!=null ? result.series : '');

                    var urlTipo = "";
                    urlTipo = "@Url.Action("GetExpedientesControlByIdInv","InventarioControl")";
                    table = $('#tableExpControl').DataTable({
                        "proccessing": true,
                        "serverSide": false,
                        "ajax": {
                            url: urlTipo,
                            data: { Id : idInv },
                            type: 'POST',
                            headers: { 'RequestVerificationToken': $('@Html.AntiForgeryToken()').val() },
                            complete: function () {
                                $("#spinner").hide();
                                var tableId = document.getElementById('tableExpControl');
                                var tBody = tableId.getElementsByTagName('tbody')[0];
                                var tableRow = tBody.getElementsByTagName('tr');
                                var anio_final=0;
                                var anios=0;
                                var fojas_tot = 0;
                                var minAnioApertura=null;
                                if(tableRow.length>0 && tableRow[0].cells.length>1){
                                    for (var t = 0; t < tableRow.length; t++) {
                                        var valor = parseInt(tableRow[t].cells[4].innerText);
                                        if (!isNaN(valor)) {
                                            if (minAnioApertura === null || valor < minAnioApertura) {
                                                minAnioApertura = valor;
                                            }
                                        }
                                    }
                                    anio_final = tableRow[tableRow.length - 1].cells[5].innerHTML;
                                    anios = minAnioApertura == anio_final ? anio_final : minAnioApertura + '-' + anio_final;
                                    for (var t = 0; t < tableRow.length; t++) {
                                        const a = parseInt(tableRow[t].cells[8].innerText);
                                        fojas_tot += isNaN(a) ? 0 : a;
                                    }
                                }
                                $('#expedientes').text(tableRow.length);
                                $('#anios').text(anios);
                            }
                        },
                        "columnDefs": columns,
                        "order": [[0, "desc"]],
                        "autoWidth": true,
                        "destroy": true,
                        "scrollY": true,
                        "scrollCollapse": true,
                        "scrollY": '60vh',
                        "paging": false,
                        "searching": false,
                        "info": false,
                        "scrollX": true,
                        "fixedColumns": true,
                        "ordering": false,
                        "language": {
                            "sProcessing": "Procesando...",
                            "sLengthMenu": "Mostrar _MENU_ registros",
                            "sZeroRecords": "No se encontraron resultados",
                            "sEmptyTable": "Ningún dato disponible en esta tabla",
                            "sInfo": "Mostrando registros del _START_ al _END_ de un total de _TOTAL_ registros",
                            "sInfoEmpty": "Mostrando registros del 0 al 0 de un total de 0 registros",
                            "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                            "sInfoPostFix": "",
                            "sSearch": "Buscar:",
                            "sUrl": "",
                            "sInfoThousands": ",",
                            "sLoadingRecords": "Cargando...",
                            "oPaginate": {
                                "sFirst": "Primero",
                                "sLast": "Último",
                                "sNext": "Siguiente",
                                "sPrevious": "Anterior"
                            }
                        }
                    });
                } else {
                    $("#alertAjax").append(result);
                    showAlert();
                }
            })
            // Se ejecuta si se produjo un error.
            .fail(function (xhr, status, error) {
                // Mostramos un mensaje de error.
                //$("#ErrorAlert").show("slow").delay(2000).hide("slow");
            })
            // Hacer algo siempre, haya sido exitosa o no.
            .always(function () {

            });
        });
        var columns = [
            { "name": "NoProg", "data": "noProg", "targets": 0 },
            {
                "data": null,
                "targets": 1,
                "render": function (data, type, row) {
                    //var fprimero = (new Date(row.fechaPrimeroAntiguo)).getFullYear();
                    //var freciente = (new Date(row.fechaUltimoReciente)).getFullYear();
                    //var periodo = freciente == fprimero ? fprimero : fprimero + '-' + freciente;
                    return row.codigo + '-' + row.consecutivo + '/' + row.periodo;
                }
            },
            { "name": "Nombre", "data": "nombre", "targets": 2 },
            { "name": "Descripcion", "data": "descripcion", "targets": 3 },
            {
                "name": "FechaPrimeroAntiguo",
                "data": "fechaPrimeroAntiguo",
                "targets": 4,
                "render": function (data, type, row) {
                    var fprimero = new Date(row.fechaPrimeroAntiguo);
                    var month = fprimero.getMonth() + 1;
                    var day = fprimero.getDate();
                    //return ((day < 10 ? '0' : '') + day + '/' + (month < 10 ? '0' : '') + month + '/' + fprimero.getFullYear());
                    return (fprimero.getFullYear());
                }
            },
            {
                "name": "FechaUltimoReciente",
                "data": "fechaUltimoReciente",
                "targets": 5,
                "render": function (data, type, row) {
                    var fprimero = new Date(row.fechaUltimoReciente);
                    var month = fprimero.getMonth() + 1;
                    var day = fprimero.getDate();
                    //return ((day < 10 ? '0' : '') + day + '/' + (month < 10 ? '0' : '') + month + '/' + fprimero.getFullYear());
                    return (fprimero.getFullYear());
                }
            },
            { "name": "Legajos", "data": "legajos", "targets": 6 },
            { "name": "CDs", "data": "cds", "targets": 7 },
            { "name": "Fojas", "data": "fojas", "targets": 8 },
            {
                "name": "Fisico",
                "data": "tipoSoporteDocumental",
                "targets": 9,
                "render": function (data, type, row) {
                    return row.tipoSoporteDocumental == 'Físico' ? 'X' : '';
                }
            },
            {
                "name": "Electronico",
                "data": "tipoSoporteDocumental",
                "targets": 10,
                "render": function (data, type, row) {
                    return row.tipoSoporteDocumental == 'Electrónico' ? 'X' : '';
                }
            },
            { "name": "VigDocValA", "data": "vigDocValA", "targets": 11 },
            { "name": "VigDocValL", "data": "vigDocValL", "targets": 12 },
            { "name": "VigDocValFC", "data": "vigDocValFC", "targets": 13 },
            { "name": "VigDocPlaConAT", "data": "vigDocPlaConAT", "targets": 14 },
            { "name": "VigDocPlaConAC", "data": "vigDocPlaConAC", "targets": 15 },
            { "name": "VigDocPlaConTot", "data": "vigDocPlaConTot", "targets": 16 },
            { "name": "Ubicacion", "data": "ubicacion", "targets": 17 },
            { "name": "Observaciones", "data": "observaciones", "targets": 18 },
        ];
        function showAlert() {
            setTimeout(function () {
                $("#alerta").fadeOut(1500);
            }, 3000);
            setTimeout(function () {
                $("#alerta").remove();
            }, 6000);
        }
        function generarPDF() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({
                orientation: 'landscape',
                unit: 'mm',
                format: 'a4',
                setFont: 'Noto Sans'
            });

            // Tabla principal
            const table = document.getElementById('tableExpControl');
            var tBody = table.getElementsByTagName('tbody')[0];
            var tableRow = tBody.getElementsByTagName('tr');
            var anio_final=0;
            var anios=0;
            var minAnioApertura = null;
            if(tableRow.length>0 && tableRow[0].cells.length>1){
                for (var t = 0; t < tableRow.length; t++) {
                    var valor = parseInt(tableRow[t].cells[4].innerText);
                    if (!isNaN(valor)) {
                        if (minAnioApertura === null || valor < minAnioApertura) {
                            minAnioApertura = valor;
                        }
                    }
                }
                anio_final = tableRow[tableRow.length - 1].cells[5].innerHTML;
                anios = minAnioApertura == anio_final ? anio_final : minAnioApertura + '-' + anio_final;
            }
            const headers = [];
            $(table).find('thead tr').each(function () {
                const header1 = [];
                $(this).find('th').each(function (){
                    header1.push({ content: $(this).text().trim(), rowSpan: $(this).prop('rowspan') || 1, colSpan: $(this).prop('colspan') || 1, });
                });
                headers.push(header1);
            });

            const data = [];
            $(table).find('tbody tr').each(function () {
                const row = [];
                $(this).find('td').each(function () {
                    row.push($(this).text().trim());
                });
                if (row.length > 0) data.push(row);
            });

            // Prepara el footer de firmas
            const firmasFooter = [
                [
                    { content: 'El presente inventario consta de {total_pages_count_string} foja(s) y ampara la cantidad de ' + tableRow.length + ' expediente(s) de los años ' + anios + ' ubicados en ' + $('#Ubicacion').text() + '. Para los expedientes con documentos electrónicos, ampara la cantidad de ' + $('#PesoElectronicos').text() + ' (MB) almacenados en ' + $('#Almacenamiento').text(), colSpan:19, styles: { halign:'center' } }
                ],
                [
                    {content: 'Elaboró', colSpan:3, styles: { minCellHeight: 30}},
                    {content: 'Validó/Entrega', colSpan: 3, styles: { minCellHeight: 30 }},
                    {content: 'Autorizó', colSpan: 7, styles: { minCellHeight: 30 }},
                    {content: 'Recibe', colSpan: 6, styles: { minCellHeight: 30 }}
                ],
                [
                    {content: '____________________________', colSpan:3 },
                    {content: '____________________________', colSpan:3 },
                    {content: '____________________________', colSpan:7 },
                    {content: '____________________________', colSpan:6 }
                ],
                [
                    {content: $('#txt_name_elab').val() || '', colSpan: 3 },
                    {content: $('#txt_name_titular').val() || '', colSpan: 3 },
                    {content: $('#txt_name_titular_dud').val() || '', colSpan: 7 },
                    {content: $('#txt_name_recibe').val() || '', colSpan: 6 }
                ],
                [
                    {content: $('#txt_cargo_elab').val() || '', colSpan: 3 },
                    {content: $('#txt_cargo_titular').val() || '', colSpan: 3 },
                    {content: $('#txt_cargo_titular_dud').val() || '', colSpan: 7 },
                    {content: '', colSpan: 6 }
                ]
            ];

            // Paginación y tabla principal
            doc.autoTable({
                head: headers,
                body: data,
                foot: firmasFooter,
                showFoot: 'lastPage',
                startY: 70,
                margin: { top:70, left:10, right: 10, bottom: 10 },
                styles: { fontSize: 8 },
                headStyles: { halign: 'center', valign: 'middle', fillColor: null, textColor: 20, lineWidth: 0.1 },
                footStyles: { halign: 'center', fillColor: null, textColor: 20 },
                theme: 'grid',
                didDrawPage: function (data) {
                    // Pie de página con paginación
                    var str = "Hoja " + doc.internal.getNumberOfPages() + " de {total_pages_count_string} del inventario";
                    var pageSize = doc.internal.pageSize;
                    // var pageHeight = pageSize.height ? pageSize.height : pageSize.getHeight();
                    const img = document.querySelector('img[src*="logo_header25.png"]');
                    if (img) {
                        // Si la imagen está cargada, la agregamos
                        // Necesitas convertir la imagen a base64 si no está en el DOM como base64
                        // Aquí se asume que está disponible
                        doc.addImage(img.src, 'PNG', 10, 10, 124, 18);
                    }
                    doc.setFontSize(10);
                    doc.setFont("helvetica", "bold");
                    doc.text('UNIDAD DE ADMINISTRACIÓN Y FINANZAS', 170, 15);
                    doc.text('DIRECCIÓN DE ADMINISTRACIÓN DE RECURSOS', 202, 20);
                    doc.text('DEPARTAMENTO DE UNIDADES DOCUMENTALES', 201, 25);
                    doc.text('Inventario general por expediente en el archivo de trámite', 100, 35);

                    // Datos generales
                    const lineasTexto = doc.splitTextToSize(`Serie: ${$('#Series').text()}`, pageSize.width - 20);
                    // Calcula la altura del bloque de texto completo
                    const alturaBloque = lineasTexto.length * (doc.getLineHeight() / doc.internal.scaleFactor);
                    const lineasTexto2 = doc.splitTextToSize(`Unidad Administrativa: ${$('#areaDescripcion').text()}`, pageSize.width - 20);
                    // Calcula la altura del bloque de texto completo
                    const alturaBloque2 = lineasTexto2.length * (doc.getLineHeight() / doc.internal.scaleFactor);
                    doc.text(`Fecha de elaboración del Inventario: ${$('#fechaElaboracion').text()}`, 10, 40);
                    doc.text(`Fondo: CONAVI`, 10, 40 + (lineasTexto.length>1 && lineasTexto2.length>1 ? 4 : 5));
                    doc.text(`Sección: ${$('#Secciones').text()}`, 10, 40 + (lineasTexto.length>1 && lineasTexto2.length>1 ? 8 : 10));
                    doc.text(`Serie: ${$('#Series').text()}`, 10, 40 + (lineasTexto.length>1 && lineasTexto2.length>1 ? 12 : 15), { align: 'left', maxWidth: pageSize.width - 20, baseline: 'alphabetic' });
                    doc.text(`Unidad Administrativa: ${$('#areaDescripcion').text()}`, 10, 40 + (lineasTexto.length>1 && lineasTexto2.length>1 ? 13 : 16) + alturaBloque, { align: 'left', maxWidth: pageSize.width - 20, baseline: 'alphabetic' });
                    doc.text(`Área generadora: ${$('#puestoDescripcion').text()}`, 10, 40 + (lineasTexto.length>1 && lineasTexto2.length>1 ? 14 : 17) + alturaBloque + alturaBloque2);
                    doc.text(str, pageSize.width - 55, 40);
                }
            });
            // Reemplaza el marcador de total de páginas
            if (typeof doc.putTotalPages === 'function') {
                doc.putTotalPages("{total_pages_count_string}");
            }
            doc.autoPrint({variant: 'non-conform'});
            doc.output("pdfobjectnewwindow");
        }
    </script>
}