@section Scripts {
    <script type="text/javascript">

        $(document).ready(function () {
            $('#btn1').click(function () {
                var id = $("#predio").val();
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("listaPredios", "IJPredio")',
                    data: { idPredio: id },
                    cache: false,
                    success: function (result) {
                        $("#spPredio").empty();
                        $("#spPredio").append("<span>" + result.id + "</span>");
                        $("#inf").show();
                        $("#acu").show();
                        $("#cont").show();
                        if (result.status == "exp") { $("#exp").show(); $("#des").hide(); $("#adq").hide();  };
                        if (result.status == "des") { $("#exp").hide(); $("#des").show(); $("#adq").hide();  };
                        if (result.status == "adq") { $("#exp").hide(); $("#des").hide(); $("#adq").show();  };
                        console.log(result.status);
                    }
                });
            });
        });

    </script>
}