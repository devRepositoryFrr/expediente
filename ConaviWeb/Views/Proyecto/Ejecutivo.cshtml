        function SendMedidasPresupuesto(){
            $('.help-block').html('');
            const ecos_arquitectonico = $('#well_ecotecnia1 [name=cmb_ecotecnia]:checked').filter(function (){ return this.value > 7 && this.value < 14; });
            if(ecos_arquitectonico.length < 1){
                $('#well_ecotecnia1').closest('[class*="col-md-12"]').find('.help-block').eq(0).html("<div class='alert alert-danger' id='alerta'>Debes seleccionar al menos una medida!!</div>");
                $('#well_ecotecnia1 [name=cmb_ecotecnia]').filter(function (){ return this.value > 7 && this.value < 14; }).each(function(){
                    $(this).prop('disabled', false).trigger('change');
                });
                $('#check_acristal').focus();
                return;
            }
            if($('#cmb_tipocombustible option:selected').val() == 0){
                $('#cmb_tipocombustible').closest('[class*="form-group"').find('.help-block').html("<div class='alert alert-danger' id='alerta'>Debes seleccionar el tipo de combustible!!</div>");
                $('#cmb_tipocombustible').focus();
                return;
            }
            if($('#cmb_obra_preventiva').prop('checked') && $('#obs_obra_preventiva').val() == ''){
                $('#cmb_obra_preventiva').closest('[class*="form-group"').find('.help-block').html("<div class='alert alert-danger' id='alerta'>Debes introducir la descripción!!</div>");
                $('#obs_obra_preventiva').focus();
                return;
            }
            if($('#volumen_demolicion').val() == '' || isNaN($('#volumen_demolicion').val())){
                $('#volumen_demolicion').closest('[class*="form-group"').find('.help-block').html("<div class='alert alert-danger' id='alerta'>Debes introducir el volumen de demolición!!</div>");
                $('#volumen_demolicion').focus();
                return;
            }
            var ecotecnias='', motrices='', obras='';
            $("input[name=cmb_ecotecnia]:checked").each(function () {
                ecotecnias = ecotecnias + $(this).val() + ",";
            });
            $("#cmb_ecotecnias").val(ecotecnias.slice(0, -1));
            $("input[name=cmb_motriz]:checked:enabled").each(function () {
                motrices = motrices + $(this).val() + ",";
            });
            $("#cmb_motrices").val(motrices.slice(0, -1));
            $("input[name=cmb_obra_preventiva]:checked:enabled").each(function () {
                obras = obras + $(this).val() + ",";
            });
            $("input[name=cmb_obra_preventivas]").val(obras.slice(0, -1));
            var data = new FormData();
            var form = $('.full_presupuesto').find('select, input[type=text], input[type=number], input:hidden');
            form = form.serializeArray();
            const json = {};
            $.each(form, function () {
                // set JSON con valor o null
                json[this.name] = this.value || null;
            });
            let ecos = JSON.stringify(json);
            data.append("json", ecos);
            data.append("idPredio", idPredio);
            $.ajax({
                type: "post",
                url: "@Url.Action("SendMedidasPresupuesto", "Proyecto")", // Url
                data: data,
                processData: false,
                contentType: false,
                success: function (result) {
                    $('#spinner').hide();
                    $('#alert').html(result.message);
                    showAlerta();
                }
            });
        }
