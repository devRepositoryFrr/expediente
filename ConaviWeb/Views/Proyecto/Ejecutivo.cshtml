<div class="modal fade" id="showModalAddBuilding" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="titulo-modal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="formAddBuilding" enctype="multipart/form-data" method="post" asp-controller="Proyecto" asp-action="AddBuilding">
                <div class='modal-header'>
                    <div class="alert alert-danger" asp-validation-summary="ModelOnly"><button class="close" data-bs-dismiss="alert" aria-hidden="true">&times;</button></div>
                    <h4 class="modal-title" id='titulo-modal'>Agregar edificio</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class='modal-body'>
                    <input asp-for="IdPredio" type="text" class="form-control" style="display:none;">
                    <input type="hidden" id="BuildingTotal" value="" style="display:none;" />
                    <div class="row">
