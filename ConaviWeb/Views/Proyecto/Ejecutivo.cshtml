@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script type="text/javascript">
        var contador = 0;
        const urlParams = new URLSearchParams(window.location.search);
        const idPredio = urlParams.get('id');
        var table;
        $(document).ready(function () {
            //showAlerta();
            if (idPredio != null) {
                getPropuesta(idPredio);
                getPresupuesto(idPredio);
                showTableEdificios(idPredio);
                $("[name='IdPredio']").val(idPredio);
                $(".fileejecutivo").each(function () {
                    GetFile(this.id);
                });
            }
            $('#showModalTrashEdificio').on('show.bs.modal', function (e) {
                var expId = $(e.relatedTarget).data('pred-id');
                $(e.currentTarget).find('#idEdificio').val(expId);
                $(e.currentTarget).find('#idPredio').val(idPredio);
            });
            $("#slc_ejfiscal").on("change", function () {
                $('#spinner').show();
                var data = new FormData();
                data.append("ejFiscal", this.value);
                $.ajax({
                    type: "post",
                    url: "@Url.Action("GetEdosPrediosList", "Levantamiento")", // Url
                    data: data,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $('#spinner').hide();
                        if (result.data != null) {
                            $("#slc_edo").html("<option>- Seleccione -</option>");
                            $(result.data).each(function () {
                                $("#slc_edo").append("<option value='"+ this.clave +"'>" + this.descripcion + "</option>");
                            });
                        }
                    }
                });
            });
            $("[name='SuperficieTerreno'],[name='SuperficieDesplante'],[name='SuperficieDonacion'],[name='SuperficieEquipamiento'],[name='SuperficieRecreativa'],[name='SuperficieRestriccion'],[name='SuperficieAreasVerdes'],[name='SuperficieCirculacionesVehiculares'],[name='SuperficieCirculacionesPeatonales'],[name='SuperficieCajonesEstacionamiento']").on("keyup change", function () {
                $("#txt_percentage_desplante").val((($("[name='SuperficieDesplante']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_donacion").val((($("[name='SuperficieDonacion']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_equipamiento").val((($("[name='SuperficieEquipamiento']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_recreativa").val((($("[name='SuperficieRecreativa']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_restriccion").val((($("[name='SuperficieRestriccion']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_areasverdes").val((($("[name='SuperficieAreasVerdes']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_circulaciones_vehiculares").val((($("[name='SuperficieCirculacionesVehiculares']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_circulaciones_peatonales").val((($("[name='SuperficieCirculacionesPeatonales']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
                $("#txt_percentage_estacionamiento").val((($("[name='SuperficieCajonesEstacionamiento']").val() / $("[name='SuperficieTerreno']").val()) * 100).toFixed(2));
            });
            $("[name='TotalViviendas'],[name='ViviendasUnifamiliar'],[name='ViviendasMultifamiliar'],[name='ViviendasRenta'],#BuildingTotal").on("keyup change", function () {
                $('#txt_total_viviendas').val(($("[name='ViviendasUnifamiliar']").val()*1 + $("[name='ViviendasMultifamiliar']").val()*1 + $("[name='ViviendasRenta']").val()*1).toFixed(0));
                $('#lbl_dif_viviendas').text('Diferencia de viviendas: ' + ($('#txt_total_viviendas').val()*1 - $('#BuildingTotal').val()*1));
                $("#txt_percentage_vivienda_unifamiliar").val((($("[name='ViviendasUnifamiliar']").val() / $("#txt_total_viviendas").val()) * 100).toFixed(2));
                $("#txt_percentage_vivienda_multifamiliar").val((($("[name='ViviendasMultifamiliar']").val() / $("#txt_total_viviendas").val()) * 100).toFixed(2));
                $("#txt_percentage_vivienda_renta").val((($("[name='ViviendasRenta']").val() / $("#txt_total_viviendas").val()) * 100).toFixed(2));
            });
            $('[name=ViviendasRenta]').on('keyup change', function (){
                if(parseInt($('#txt_percentage_vivienda_renta').val()) != 20){
                    $(this).parent().parent().find('.help-block').html('<div class="alert alert-warning">Evaluar y en su caso justificar la propuesta, se recomienda considerar 20% para vivienda en renta</div>').slideDown('slow');
                }else{
                    $(this).parent().parent().find('.help-block').slideUp('slow').html('');
