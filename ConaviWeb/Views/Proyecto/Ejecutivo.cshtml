        function count (contador){
            if (contador == 0){
                $("#1").addClass("hidden");
                $("#2").addClass("hidden");
                $("#3").addClass("hidden");
                $("#4").addClass("hidden");
                $("#5").addClass("hidden");
                $("#6").addClass("hidden");
                $("#0").removeClass("hidden");
