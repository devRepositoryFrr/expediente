        function UploadPCFile(element) {
            var file = $(element).parent().find(":file");
            if ($("#" + file[0].id)[0].files[0] != null && idPredio != 0 && idPredio != null) {
                $('#spinner').show();
                var data = new FormData();
                let json = JSON.stringify({ idPredio: idPredio, nameFile: file[0].id });
                data.append("json", json);
                data.append('file', $("#" + file[0].id)[0].files[0]);
                $.ajax({
                    type: "post",
                    url: "@Url.Action("UploadArchivoEjecutivo", "Proyecto")", // Url
                    data: data,
                    processData: false,
                    contentType: false,
                    success: function (data) {
                        $('#spinner').hide();
                        $("#alert").html(data.message);
                        //window.scrollTo(0,0);
                        GetFile(file[0].id);
                        showAlerta();
                    }
                });
            } else {
                $("#" + file[0].id).focus();
            }
        }
