        function getPercentage(){
            let porcentaje = 0;
            console.log('entra al getPercentage',porcentaje);
            var s1=0, s2=0, s4=0, s4a=0, s4b=0, s5=0, s5a=0;
            $('.seccion-uno').each(function(e){
                if(this.type == 'number' && (this.value == null || this.value == ''))   //si no están capturadas las superficies
                    s1++;
                if(this.type == 'select-multiple' && this.selectedOptions.length == 0){     //si no han seleccionado los niveles
                    s1++;
                }
                if(this.type == 'button' && this.disabled){     //si no están cargados los archivos del anteproyecto
                    s1++;
                }
            });
            $('.seccion-dos').each(function(){
                if(this.type == 'button' && this.disabled)  //si no está cargado el archivo de mecánica de suelos
                    s2++;
            });
            $('.seccion-cuatro').each(function(){
                if(this.type == 'checkbox' && this.name == 'cmb_ecotecnia' && this.checked && this.value != 14) //medidas de sustentabilidad - envolvente térmica
                    s4a++;
                if(this.type == 'checkbox' && this.name == 'cmb_ecotecnia' && !this.checked && this.value == 14)    //sembrado de árboles
                    s4++;
                if(this.type == 'checkbox' && this.name == 'cmb_motriz' && this.checked)    //linea complementaria de accesibilidad(se incrementa al estar seleccionada)
                    s4b++;
                if(this.type == 'button' && this.disabled)  //si no está cargado el archivo de complemento arquitectónico
                    s4++;
                if(this.type == 'number' && (isNaN(this.value) || this.value == ''))    //si no está capturado el volúmen de demolición
                    s4++;
            });
            $('.seccion-cinco').each(function(){
                if(this.type == 'checkbox' && this.name == 'cmb_obra_preventiva' && this.checked) //linea de apoyo complementaria de obra preventiva
                    s5a++;
                if(this.type == 'button' && !this.disabled)  //si está cargado el archivo de memoria de calculo estructural y planos estructurales
                    s5++;
            });
            console.log('s1',s1,'s2',s2,'s4',s4,'s4a',s4a,'s4b',s4b,'s5',s5,'s5a',s5a);
            if(s1 == 0)
                porcentaje += 18;
            if(s2 == 0)
                porcentaje += 19;
            if(s4 == 0 && s4a>0 && s4b>0)
                porcentaje += 15;
            if(s5 == 2 && s5a>0)
                porcentaje += 19;
            $(".progress-bar").attr("aria-valuenow", porcentaje).css("width", porcentaje+ '%').html(porcentaje + "%");
            console.log('sale del getPercentage',porcentaje);
        }
    </script>

